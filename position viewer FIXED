-- Position Viewer with Drag & Copy (Mobile Friendly)
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "PositionViewer"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Main Frame (Positioned at Top Right)
local frame = Instance.new("Frame")
frame.Name = "PosFrame"
frame.Size = UDim2.new(0, 280, 0, 80)
frame.Position = UDim2.new(1, -300, 0, 20)  -- Top Right Corner
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
frame.BorderSizePixel = 0
frame.BackgroundTransparency = 0.1
frame.Parent = screenGui

-- Corner radius
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

-- Stroke
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(60, 60, 70)
stroke.Thickness = 1.5
stroke.Parent = frame

-- Position Label
local posLabel = Instance.new("TextLabel")
posLabel.Size = UDim2.new(0.65, 0, 1, 0)
posLabel.BackgroundTransparency = 1
posLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
posLabel.TextScaled = true
posLabel.Font = Enum.Font.GothamSemibold
posLabel.Text = "Position: (0, 0, 0)"
posLabel.TextXAlignment = Enum.TextXAlignment.Left
posLabel.Parent = frame

local padding = Instance.new("UIPadding")
padding.PaddingLeft = UDim.new(0, 12)
padding.Parent = posLabel

-- Copy Button (Dark Grey by default)
local copyButton = Instance.new("TextButton")
copyButton.Size = UDim2.new(0.32, 0, 0.7, 0)
copyButton.Position = UDim2.new(0.65, 5, 0.15, 0)
copyButton.BackgroundColor3 = Color3.fromRGB(45, 45, 50)  -- Permanent Dark Grey
copyButton.Text = "Copy"
copyButton.TextColor3 = Color3.new(1,1,1)
copyButton.TextScaled = true
copyButton.Font = Enum.Font.GothamBold
copyButton.Parent = frame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 8)
btnCorner.Parent = copyButton

-- Variables for dragging
local dragging = false
local dragStart = nil
local startPos = nil

-- Update position every frame (as integers)
local function updatePosition()
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local pos = character.HumanoidRootPart.Position
        local x = math.floor(pos.X + 0.5)
        local y = math.floor(pos.Y + 0.5)
        local z = math.floor(pos.Z + 0.5)
        
        posLabel.Text = string.format("Position: (%d, %d, %d)", x, y, z)
    end
end

game:GetService("RunService").RenderStepped:Connect(updatePosition)

-- Copy function
copyButton.MouseButton1Click:Connect(function()
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local pos = character.HumanoidRootPart.Position
        local x = math.floor(pos.X + 0.5)
        local y = math.floor(pos.Y + 0.5)
        local z = math.floor(pos.Z + 0.5)
        
        local posString = string.format("%d, %d, %d", x, y, z)
        
        setclipboard(posString)
        
        -- Visual feedback (text only)
        copyButton.Text = "Copied!"
        
        task.wait(1.5)
        copyButton.Text = "Copy"
    end
end)

-- === Custom Drag System (PC + Mobile) ===
local function onInputBegan(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
       
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end

local function onInputChanged(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
                     input.UserInputType == Enum.UserInputType.Touch) then
                     
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, 
                                   startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end

frame.InputBegan:Connect(onInputBegan)
game:GetService("UserInputService").InputChanged:Connect(onInputChanged)

print("Position Viewer loaded! Started at top right corner.")
